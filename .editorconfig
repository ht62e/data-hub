root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 100

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_chained_property = false
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false
csharp_prefer_braces = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_expression_bodied_properties = when_possible:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion

# Google C# naming: private/protected fields and properties use _camelCase.
dotnet_naming_rule.google_private_members.symbols = google_private_members
dotnet_naming_rule.google_private_members.style = google_private_members_style
dotnet_naming_rule.google_private_members.severity = suggestion
dotnet_naming_symbols.google_private_members.applicable_kinds = field,property
dotnet_naming_symbols.google_private_members.applicable_accessibilities = private,protected,internal,protected_internal
dotnet_naming_style.google_private_members_style.required_prefix = _
dotnet_naming_style.google_private_members_style.capitalization = camel_case

# Google C# naming: methods and types use PascalCase.
dotnet_naming_rule.google_pascal_case.symbols = google_pascal_case_symbols
dotnet_naming_rule.google_pascal_case.style = google_pascal_case_style
dotnet_naming_rule.google_pascal_case.severity = suggestion
dotnet_naming_symbols.google_pascal_case_symbols.applicable_kinds = class,struct,interface,enum,method,property,event,delegate
dotnet_naming_symbols.google_pascal_case_symbols.applicable_accessibilities = public,private,protected,internal,protected_internal
dotnet_naming_style.google_pascal_case_style.capitalization = pascal_case

# Google C# naming: locals and parameters use camelCase.
dotnet_naming_rule.google_camel_case.symbols = google_camel_case_symbols
dotnet_naming_rule.google_camel_case.style = google_camel_case_style
dotnet_naming_rule.google_camel_case.severity = suggestion
dotnet_naming_symbols.google_camel_case_symbols.applicable_kinds = local,parameter
dotnet_naming_style.google_camel_case_style.capitalization = camel_case

